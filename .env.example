# Lokal udvikling kører mod Firebase Emulator Suite (npm run emulators).
# Sæt til false og udfyld resten for at bygge mod et rigtigt projekt.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=bogfort-local
VITE_FIREBASE_STORAGE_BUCKET=bogfort-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
